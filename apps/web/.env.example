# apps/web environment. No secrets belong in this file or in any VITE_ variable:
# everything prefixed with VITE_ is inlined into the JavaScript bundle and is
# readable by anyone who loads the page.

# Origin the dev server proxies /api and /internal to.
VITE_API_ORIGIN=http://localhost:8080

# Port for `pnpm --filter @job-getter/web dev`.
VITE_PORT=5173

# Origin (not path prefix) the browser should call at runtime. Leave empty to
# use the page's own origin, which is the normal setup: the dev server proxies
# and production runs behind one reverse proxy. The /api/v1 prefix is added by
# the generated client, so do not include it here.
VITE_API_BASE_URL=

# Where IMPLEMENTATION_STATUS.md is published for this deployment.
# Defaults to /IMPLEMENTATION_STATUS.md.
VITE_IMPLEMENTATION_STATUS_URL=
