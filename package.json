{
  "name": "job-getter",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "contracts:generate": "pnpm --filter @job-getter/contracts generate",
    "contracts:check": "pnpm --filter @job-getter/contracts check",
    "typecheck": "pnpm --filter @job-getter/contracts build && pnpm --filter @job-getter/api-client build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @job-getter/contracts build && pnpm --filter @job-getter/api-client build && pnpm -r test",
    "dev": "pnpm -r --parallel dev",
    "migrate": "pnpm --filter @job-getter/api migrate",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  }
}
