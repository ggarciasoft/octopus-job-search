{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/FillLocalInput.schema.json",
  "title": "FillLocalInput",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "application_id",
    "packet_id",
    "content_hash",
    "device_id",
    "destination",
    "allowed_origins",
    "job",
    "resume_file_id",
    "resume_sha256",
    "resume_filename",
    "fields",
    "known_form_fingerprint",
    "adapter"
  ],
  "properties": {
    "application_id": {
      "format": "uuid",
      "type": "string"
    },
    "packet_id": {
      "format": "uuid",
      "type": "string"
    },
    "content_hash": {
      "minLength": 64,
      "maxLength": 64,
      "type": "string"
    },
    "device_id": {
      "format": "uuid",
      "type": "string"
    },
    "destination": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url",
        "origin",
        "connector",
        "connector_version"
      ],
      "properties": {
        "url": {
          "maxLength": 2000,
          "type": "string"
        },
        "origin": {
          "maxLength": 500,
          "type": "string"
        },
        "connector": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "connector_version": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "allowed_origins": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "maxLength": 500,
        "type": "string"
      }
    },
    "job": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "job_id",
        "company",
        "title"
      ],
      "properties": {
        "job_id": {
          "format": "uuid",
          "type": "string"
        },
        "company": {
          "maxLength": 200,
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "type": "string"
        }
      }
    },
    "resume_file_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resume_filename": {
      "anyOf": [
        {
          "maxLength": 260,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_key",
          "label",
          "answer",
          "required",
          "sensitivity"
        ],
        "properties": {
          "question_key": {
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9_.:-]+$",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "answer": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "maxLength": 500,
                  "type": "string"
                }
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "sensitivity": {
            "anyOf": [
              {
                "const": "standard",
                "type": "string"
              },
              {
                "const": "sensitive",
                "type": "string"
              },
              {
                "const": "never_reuse",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "known_form_fingerprint": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
