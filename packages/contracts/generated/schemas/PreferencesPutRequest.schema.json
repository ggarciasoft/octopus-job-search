{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/PreferencesPutRequest.schema.json",
  "title": "PreferencesPutRequest",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "expected_revision",
    "config"
  ],
  "properties": {
    "expected_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "config": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "settings_version",
        "target_titles",
        "excluded_titles",
        "required_skills",
        "preferred_skills",
        "excluded_companies",
        "countries",
        "remote_modes",
        "employment_types",
        "languages",
        "salary",
        "sponsorship_policy",
        "unknown_eligibility_policy",
        "scan_interval_hours",
        "match_weights",
        "cv_language",
        "cv_template",
        "resume_mode",
        "limits",
        "prompt_style_suffix"
      ],
      "properties": {
        "settings_version": {
          "const": 1,
          "type": "number"
        },
        "target_titles": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 120,
            "type": "string"
          }
        },
        "excluded_titles": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 120,
            "type": "string"
          }
        },
        "required_skills": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 120,
            "type": "string"
          }
        },
        "preferred_skills": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 120,
            "type": "string"
          }
        },
        "excluded_companies": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 120,
            "type": "string"
          }
        },
        "countries": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          }
        },
        "remote_modes": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "remote",
                "type": "string"
              },
              {
                "const": "hybrid",
                "type": "string"
              },
              {
                "const": "onsite",
                "type": "string"
              }
            ]
          }
        },
        "employment_types": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "full_time",
                "type": "string"
              },
              {
                "const": "part_time",
                "type": "string"
              },
              {
                "const": "contract",
                "type": "string"
              },
              {
                "const": "internship",
                "type": "string"
              },
              {
                "const": "temporary",
                "type": "string"
              },
              {
                "const": "freelance",
                "type": "string"
              }
            ]
          }
        },
        "languages": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "type": "string"
          }
        },
        "salary": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "minimum",
                "currency",
                "period"
              ],
              "properties": {
                "minimum": {
                  "minimum": 0,
                  "type": "number"
                },
                "currency": {
                  "pattern": "^[A-Z]{3}$",
                  "type": "string"
                },
                "period": {
                  "anyOf": [
                    {
                      "const": "year",
                      "type": "string"
                    },
                    {
                      "const": "month",
                      "type": "string"
                    },
                    {
                      "const": "week",
                      "type": "string"
                    },
                    {
                      "const": "day",
                      "type": "string"
                    },
                    {
                      "const": "hour",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "sponsorship_policy": {
          "anyOf": [
            {
              "const": "allow",
              "type": "string"
            },
            {
              "const": "avoid",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ]
        },
        "unknown_eligibility_policy": {
          "anyOf": [
            {
              "const": "review",
              "type": "string"
            },
            {
              "const": "hide",
              "type": "string"
            }
          ]
        },
        "scan_interval_hours": {
          "minimum": 1,
          "maximum": 168,
          "type": "integer"
        },
        "match_weights": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "skills",
            "role_title",
            "seniority",
            "work_arrangement",
            "industry"
          ],
          "properties": {
            "skills": {
              "minimum": 0,
              "maximum": 100,
              "type": "integer"
            },
            "role_title": {
              "minimum": 0,
              "maximum": 100,
              "type": "integer"
            },
            "seniority": {
              "minimum": 0,
              "maximum": 100,
              "type": "integer"
            },
            "work_arrangement": {
              "minimum": 0,
              "maximum": 100,
              "type": "integer"
            },
            "industry": {
              "minimum": 0,
              "maximum": 100,
              "type": "integer"
            }
          }
        },
        "cv_language": {
          "anyOf": [
            {
              "const": "en",
              "type": "string"
            },
            {
              "const": "es",
              "type": "string"
            }
          ]
        },
        "cv_template": {
          "const": "simple",
          "type": "string"
        },
        "resume_mode": {
          "anyOf": [
            {
              "const": "original",
              "type": "string"
            },
            {
              "const": "tailored",
              "type": "string"
            }
          ]
        },
        "limits": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "scan_max_jobs",
            "request_concurrency_per_host",
            "ai_requests_per_day",
            "fill_attempts_per_day",
            "approval_ttl_hours",
            "consented_evidence_capture",
            "raw_logs"
          ],
          "properties": {
            "scan_max_jobs": {
              "minimum": 1,
              "maximum": 1000,
              "type": "integer"
            },
            "request_concurrency_per_host": {
              "minimum": 1,
              "maximum": 1,
              "type": "integer"
            },
            "ai_requests_per_day": {
              "minimum": 0,
              "maximum": 1000,
              "type": "integer"
            },
            "fill_attempts_per_day": {
              "minimum": 0,
              "maximum": 100,
              "type": "integer"
            },
            "approval_ttl_hours": {
              "minimum": 1,
              "maximum": 24,
              "type": "integer"
            },
            "consented_evidence_capture": {
              "type": "boolean"
            },
            "raw_logs": {
              "type": "boolean"
            }
          }
        },
        "prompt_style_suffix": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
