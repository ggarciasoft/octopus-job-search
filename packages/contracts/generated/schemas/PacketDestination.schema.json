{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/PacketDestination.schema.json",
  "title": "PacketDestination",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "url",
    "origin",
    "connector",
    "connector_version"
  ],
  "properties": {
    "url": {
      "maxLength": 2000,
      "type": "string"
    },
    "origin": {
      "maxLength": 500,
      "type": "string"
    },
    "connector": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "connector_version": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
