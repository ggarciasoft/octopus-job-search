{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/LanguageValue.schema.json",
  "title": "LanguageValue",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "code",
    "declared_level"
  ],
  "properties": {
    "code": {
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "type": "string"
    },
    "declared_level": {
      "anyOf": [
        {
          "const": "basic",
          "type": "string"
        },
        {
          "const": "conversational",
          "type": "string"
        },
        {
          "const": "professional",
          "type": "string"
        },
        {
          "const": "native",
          "type": "string"
        }
      ]
    }
  }
}
