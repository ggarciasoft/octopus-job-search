{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/ScanView.schema.json",
  "title": "ScanView",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "source_id",
    "task_id",
    "status",
    "complete_snapshot",
    "counts",
    "error_code",
    "error_message",
    "started_at",
    "completed_at",
    "created_at"
  ],
  "properties": {
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "partial",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "complete_snapshot": {
      "type": "boolean"
    },
    "counts": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "fetched",
        "created",
        "updated",
        "unchanged",
        "closed",
        "pages"
      ],
      "properties": {
        "fetched": {
          "minimum": 0,
          "type": "integer"
        },
        "created": {
          "minimum": 0,
          "type": "integer"
        },
        "updated": {
          "minimum": 0,
          "type": "integer"
        },
        "unchanged": {
          "minimum": 0,
          "type": "integer"
        },
        "closed": {
          "minimum": 0,
          "type": "integer"
        },
        "pages": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_message": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    }
  }
}
