{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/SubmissionEvidence.schema.json",
  "title": "SubmissionEvidence",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "evidence_type",
    "confirmation_text",
    "reference",
    "url",
    "observed_at",
    "screenshot_file_id",
    "note"
  ],
  "properties": {
    "evidence_type": {
      "anyOf": [
        {
          "const": "adapter_observed",
          "type": "string"
        },
        {
          "const": "user_report",
          "type": "string"
        },
        {
          "const": "none",
          "type": "string"
        }
      ]
    },
    "confirmation_text": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "screenshot_file_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
