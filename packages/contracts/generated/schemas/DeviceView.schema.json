{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/DeviceView.schema.json",
  "title": "DeviceView",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "label",
    "status",
    "device_public_id",
    "allowed_origins",
    "expires_at",
    "revoked_at",
    "last_seen_at",
    "created_at"
  ],
  "properties": {
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "kind": {
      "anyOf": [
        {
          "const": "local_runner",
          "type": "string"
        },
        {
          "const": "extension",
          "type": "string"
        }
      ]
    },
    "label": {
      "maxLength": 120,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "paired",
          "type": "string"
        },
        {
          "const": "revoked",
          "type": "string"
        },
        {
          "const": "expired",
          "type": "string"
        }
      ]
    },
    "device_public_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_origins": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "maxLength": 500,
        "type": "string"
      }
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_seen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    }
  }
}
