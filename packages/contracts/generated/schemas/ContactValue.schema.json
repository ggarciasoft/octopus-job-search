{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/ContactValue.schema.json",
  "title": "ContactValue",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "full_name",
    "email"
  ],
  "properties": {
    "full_name": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "email": {
      "minLength": 3,
      "maxLength": 320,
      "type": "string"
    },
    "phone": {
      "maxLength": 40,
      "type": "string"
    },
    "city": {
      "maxLength": 120,
      "type": "string"
    },
    "country": {
      "maxLength": 120,
      "type": "string"
    },
    "links": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "minLength": 1,
            "maxLength": 60,
            "type": "string"
          },
          "url": {
            "minLength": 1,
            "maxLength": 500,
            "type": "string"
          }
        }
      }
    }
  }
}
