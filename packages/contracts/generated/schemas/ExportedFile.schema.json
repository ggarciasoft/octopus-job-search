{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/ExportedFile.schema.json",
  "title": "ExportedFile",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "path",
    "file_id",
    "original_name",
    "mime",
    "bytes",
    "sha256",
    "purpose"
  ],
  "properties": {
    "path": {
      "maxLength": 500,
      "type": "string"
    },
    "file_id": {
      "format": "uuid",
      "type": "string"
    },
    "original_name": {
      "maxLength": 260,
      "type": "string"
    },
    "mime": {
      "maxLength": 200,
      "type": "string"
    },
    "bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "sha256": {
      "maxLength": 64,
      "type": "string"
    },
    "purpose": {
      "maxLength": 40,
      "type": "string"
    }
  }
}
