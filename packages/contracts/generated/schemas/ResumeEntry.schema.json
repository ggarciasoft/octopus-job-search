{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/ResumeEntry.schema.json",
  "title": "ResumeEntry",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "title",
    "organization",
    "start_month",
    "end_month",
    "current",
    "detail",
    "bullets",
    "fact_ids"
  ],
  "properties": {
    "title": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "organization": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "start_month": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "end_month": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "current": {
      "type": "boolean"
    },
    "detail": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "bullets": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "fact_ids"
        ],
        "properties": {
          "text": {
            "minLength": 1,
            "maxLength": 600,
            "type": "string"
          },
          "fact_ids": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "format": "uuid",
              "type": "string"
            }
          }
        }
      }
    },
    "fact_ids": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "format": "uuid",
        "type": "string"
      }
    }
  }
}
