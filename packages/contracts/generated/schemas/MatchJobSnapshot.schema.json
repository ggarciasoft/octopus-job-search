{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/MatchJobSnapshot.schema.json",
  "title": "MatchJobSnapshot",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "company",
    "title",
    "description_text",
    "locations",
    "remote_type",
    "eligible_countries",
    "employment_type",
    "salary",
    "language",
    "requirements"
  ],
  "properties": {
    "company": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "maxLength": 300,
      "type": "string"
    },
    "description_text": {
      "maxLength": 200000,
      "type": "string"
    },
    "locations": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "country",
          "region",
          "city",
          "source_excerpt"
        ],
        "properties": {
          "country": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "region": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_excerpt": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "remote_type": {
      "anyOf": [
        {
          "const": "remote",
          "type": "string"
        },
        {
          "const": "hybrid",
          "type": "string"
        },
        {
          "const": "onsite",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ]
    },
    "eligible_countries": {
      "anyOf": [
        {
          "maxItems": 250,
          "type": "array",
          "items": {
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "employment_type": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "full_time",
              "type": "string"
            },
            {
              "const": "part_time",
              "type": "string"
            },
            {
              "const": "contract",
              "type": "string"
            },
            {
              "const": "internship",
              "type": "string"
            },
            {
              "const": "temporary",
              "type": "string"
            },
            {
              "const": "freelance",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "salary": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "min",
            "max",
            "currency",
            "period",
            "source_excerpt"
          ],
          "properties": {
            "min": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "max": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "pattern": "^[A-Z]{3}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "period": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "const": "year",
                      "type": "string"
                    },
                    {
                      "const": "month",
                      "type": "string"
                    },
                    {
                      "const": "week",
                      "type": "string"
                    },
                    {
                      "const": "day",
                      "type": "string"
                    },
                    {
                      "const": "hour",
                      "type": "string"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_excerpt": {
              "minLength": 1,
              "maxLength": 300,
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "anyOf": [
        {
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requirements": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "kind",
          "evidence_excerpt"
        ],
        "properties": {
          "text": {
            "minLength": 1,
            "maxLength": 600,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "required",
                "type": "string"
              },
              {
                "const": "preferred",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              }
            ]
          },
          "evidence_excerpt": {
            "minLength": 1,
            "maxLength": 600,
            "type": "string"
          }
        }
      }
    }
  }
}
