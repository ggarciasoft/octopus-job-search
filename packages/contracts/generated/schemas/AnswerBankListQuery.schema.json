{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/AnswerBankListQuery.schema.json",
  "title": "AnswerBankListQuery",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "question_key": {
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9_.:-]+$",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "const": "general",
          "type": "string"
        },
        {
          "const": "company",
          "type": "string"
        },
        {
          "const": "job",
          "type": "string"
        }
      ]
    },
    "cursor": {
      "type": "string"
    },
    "limit": {
      "minimum": 1,
      "maximum": 100,
      "type": "integer"
    }
  }
}
