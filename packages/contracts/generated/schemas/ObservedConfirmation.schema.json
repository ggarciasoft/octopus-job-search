{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/ObservedConfirmation.schema.json",
  "title": "ObservedConfirmation",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "confirmation_text",
    "reference",
    "url",
    "observed_at"
  ],
  "properties": {
    "confirmation_text": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    }
  }
}
