{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/ResumesListQuery.schema.json",
  "title": "ResumesListQuery",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "job_id": {
      "format": "uuid",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "ready",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        }
      ]
    },
    "cursor": {
      "type": "string"
    },
    "limit": {
      "minimum": 1,
      "maximum": 100,
      "type": "integer"
    }
  }
}
