{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/ObserveConfirmationInput.schema.json",
  "title": "ObserveConfirmationInput",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "application_id",
    "packet_id",
    "device_id",
    "destination",
    "allowed_origins",
    "timeout_seconds",
    "adapter",
    "capture_evidence"
  ],
  "properties": {
    "application_id": {
      "format": "uuid",
      "type": "string"
    },
    "packet_id": {
      "format": "uuid",
      "type": "string"
    },
    "device_id": {
      "format": "uuid",
      "type": "string"
    },
    "destination": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url",
        "origin",
        "connector",
        "connector_version"
      ],
      "properties": {
        "url": {
          "maxLength": 2000,
          "type": "string"
        },
        "origin": {
          "maxLength": 500,
          "type": "string"
        },
        "connector": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "connector_version": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "allowed_origins": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "maxLength": 500,
        "type": "string"
      }
    },
    "timeout_seconds": {
      "minimum": 5,
      "maximum": 600,
      "type": "integer"
    },
    "adapter": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "capture_evidence": {
      "type": "boolean"
    }
  }
}
