{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/UsageReserveRequest.schema.json",
  "title": "UsageReserveRequest",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "lease_token",
    "estimated_input_tokens",
    "estimated_output_tokens"
  ],
  "properties": {
    "lease_token": {
      "minLength": 32,
      "type": "string"
    },
    "estimated_input_tokens": {
      "minimum": 0,
      "maximum": 10000000,
      "type": "integer"
    },
    "estimated_output_tokens": {
      "minimum": 0,
      "maximum": 10000000,
      "type": "integer"
    }
  }
}
