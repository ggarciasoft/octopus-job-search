{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/PairingCodeResponse.schema.json",
  "title": "PairingCodeResponse",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "device_id",
    "pairing_code",
    "expires_in"
  ],
  "properties": {
    "device_id": {
      "format": "uuid",
      "type": "string"
    },
    "pairing_code": {
      "minLength": 8,
      "maxLength": 120,
      "type": "string"
    },
    "expires_in": {
      "minimum": 1,
      "type": "integer"
    }
  }
}
