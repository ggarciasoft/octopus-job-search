{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/UsageSettleResponse.schema.json",
  "title": "UsageSettleResponse",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "reservation_id",
    "input_tokens",
    "output_tokens",
    "measured_cost",
    "currency",
    "cost_is_unknown"
  ],
  "properties": {
    "reservation_id": {
      "format": "uuid",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "type": "integer"
    },
    "output_tokens": {
      "minimum": 0,
      "type": "integer"
    },
    "measured_cost": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_is_unknown": {
      "type": "boolean"
    }
  }
}
