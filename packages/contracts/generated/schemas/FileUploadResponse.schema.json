{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/FileUploadResponse.schema.json",
  "title": "FileUploadResponse",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "file",
    "validation"
  ],
  "properties": {
    "file": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "original_name",
        "mime",
        "bytes",
        "sha256",
        "purpose",
        "state",
        "created_at"
      ],
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "original_name": {
          "maxLength": 255,
          "type": "string"
        },
        "mime": {
          "maxLength": 128,
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "purpose": {
          "anyOf": [
            {
              "const": "cv_original",
              "type": "string"
            },
            {
              "const": "profile_text",
              "type": "string"
            },
            {
              "const": "generated_cv",
              "type": "string"
            },
            {
              "const": "export",
              "type": "string"
            },
            {
              "const": "evidence",
              "type": "string"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "const": "staging",
              "type": "string"
            },
            {
              "const": "ready",
              "type": "string"
            },
            {
              "const": "deleting",
              "type": "string"
            }
          ]
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        }
      }
    },
    "validation": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "signature_ok",
        "extension_matches_signature",
        "encrypted",
        "malware_scan",
        "warnings"
      ],
      "properties": {
        "signature_ok": {
          "type": "boolean"
        },
        "extension_matches_signature": {
          "type": "boolean"
        },
        "encrypted": {
          "type": "boolean"
        },
        "malware_scan": {
          "anyOf": [
            {
              "const": "clean",
              "type": "string"
            },
            {
              "const": "skipped_not_configured",
              "type": "string"
            },
            {
              "const": "quarantined",
              "type": "string"
            },
            {
              "const": "pending",
              "type": "string"
            }
          ]
        },
        "warnings": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "maxLength": 300,
            "type": "string"
          }
        }
      }
    }
  }
}
