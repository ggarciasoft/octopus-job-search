    "created": {
      "minimum": 0,
      "type": "integer"
    },
    "updated": {
      "minimum": 0,
      "type": "integer"
    },
    "unchanged": {
      "minimum": 0,
      "type": "integer"
    },
    "closed": {
      "minimum": 0,
      "type": "integer"
    },
    "pages": {
      "minimum": 0,
      "type": "integer"
    }
  }
}
