{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/LoginRequest.schema.json",
  "title": "LoginRequest",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "email",
    "password"
  ],
  "properties": {
    "email": {
      "minLength": 3,
      "maxLength": 320,
      "type": "string"
    },
    "password": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    }
  }
}
