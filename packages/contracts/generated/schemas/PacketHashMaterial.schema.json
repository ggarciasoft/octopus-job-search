{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-getter.local/schemas/PacketHashMaterial.schema.json",
  "title": "PacketHashMaterial",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "hash_version",
    "profile_revision",
    "job_id",
    "job_revision",
    "resume_id",
    "resume_sha256",
    "destination",
    "form_fingerprint",
    "answers"
  ],
  "properties": {
    "hash_version": {
      "minimum": 1,
      "type": "integer"
    },
    "profile_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "job_id": {
      "format": "uuid",
      "type": "string"
    },
    "job_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "resume_id": {
      "format": "uuid",
      "type": "string"
    },
    "resume_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url",
        "origin",
        "connector",
        "connector_version"
      ],
      "properties": {
        "url": {
          "maxLength": 2000,
          "type": "string"
        },
        "origin": {
          "maxLength": 500,
          "type": "string"
        },
        "connector": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "connector_version": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "form_fingerprint": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "answers": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_key",
          "answer",
          "provenance"
        ],
        "properties": {
          "question_key": {
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9_.:-]+$",
            "type": "string"
          },
          "answer": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "maxLength": 5000,
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "maxLength": 500,
                      "type": "string"
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "anyOf": [
              {
                "const": "user_entered",
                "type": "string"
              },
              {
                "const": "answer_bank",
                "type": "string"
              },
              {
                "const": "profile_fact",
                "type": "string"
              },
              {
                "const": "preference",
                "type": "string"
              }
            ]
          }
        }
      }
    }
  }
}
