# =============================================================================
# Local Compose overrides - EXAMPLE
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# Docker Compose picks up `docker-compose.override.yml` automatically and
# merges it over docker-compose.yml.
#
# `docker-compose.override.yml` is gitignored. An override is a personal,
# machine-specific file; committing one would silently change the stack for
# everybody else.
#
# Everything here is OFF by default and each block explains what you are giving
# up by turning it on. The committed docker-compose.yml is the safe baseline;
# this file is where you knowingly deviate from it.
# =============================================================================

services:

  # ---------------------------------------------------------------------------
  # Publish PostgreSQL to your machine.
  #
  # TRADE-OFF: docker-compose.yml deliberately does not publish the database
  # (docs/spec/10_DEPLOYMENT.md). Publishing it puts a password-authenticated
  # database on a host port. Keep it on 127.0.0.1 - never 0.0.0.0 - and change
  # POSTGRES_PASSWORD in .env from the example default first.
  #
  # You usually do NOT need this. For a one-off query, prefer:
  #   docker compose exec db psql -U jobgetter -d jobgetter
  # ---------------------------------------------------------------------------
  # db:
  #   ports:
  #     - "127.0.0.1:5432:5432"

  # ---------------------------------------------------------------------------
  # Publish the API directly, bypassing the web container's proxy.
  #
  # TRADE-OFF: this also exposes /internal/v1/* - the worker task protocol - on
  # a host port. Those routes are credential-protected (WORKER_AUTH_TOKEN) but
  # docs/spec/10_DEPLOYMENT.md asks that they not be generally reachable. Use
  # this for API debugging on a machine you trust, and remove it afterwards.
  #
  # scripts/smoke.sh does NOT need this; it goes through http://localhost:3000
  # like a browser does.
  # ---------------------------------------------------------------------------
  # api:
  #   ports:
  #     - "127.0.0.1:8080:8080"

  # ---------------------------------------------------------------------------
  # Publish the optional local model endpoint.
  # Only meaningful together with `--profile local-ai`.
  # ---------------------------------------------------------------------------
  # ollama:
  #   ports:
  #     - "127.0.0.1:11434:11434"

  # ---------------------------------------------------------------------------
  # Run more than one processing worker.
  #
  # PostgreSQL leases (SELECT FOR UPDATE SKIP LOCKED) coordinate replicas, so
  # this is safe with no extra infrastructure. Give each replica a distinct
  # WORKER_ID... which `deploy.replicas` cannot do, so scale with:
  #   docker compose up -d --scale worker=3
  # and let the worker derive its id from the container hostname if it supports
  # that. Check services/worker/README.md before relying on it.
  #
  # Still no fill_local here: a container cannot drive your desktop browser.
  # ---------------------------------------------------------------------------
  # worker:
  #   deploy:
  #     replicas: 2

  # ---------------------------------------------------------------------------
  # Serve the UI on a different loopback port (e.g. 3000 is already taken).
  # Prefer setting WEB_PORT in .env; this is the override form.
  # Keep the 127.0.0.1 prefix.
  # ---------------------------------------------------------------------------
  # web:
  #   ports:
  #     - "127.0.0.1:3100:8080"

  # ---------------------------------------------------------------------------
  # Replace the reverse-proxy configuration without rebuilding the web image.
  # Useful when you rename services or add a TLS terminator in front.
  # ---------------------------------------------------------------------------
  # web:
  #   volumes:
  #     - ./infra/proxy/nginx.conf:/etc/nginx/nginx.conf:ro

  # ---------------------------------------------------------------------------
  # Bind-mount the files volume to a directory you can browse.
  #
  # TRADE-OFF: the baseline uses a named volume so `docker compose down`
  # preserves data and so private uploads are not sitting in your project
  # directory where a `git add -A` could catch them. If you bind-mount, put the
  # target OUTSIDE the repository.
  # ---------------------------------------------------------------------------
  # api:
  #   volumes:
  #     - /absolute/path/outside/the/repo/job-getter-files:/var/lib/job-getter/files

  # ---------------------------------------------------------------------------
  # Your network intercepts TLS (corporate proxy, or an antivirus "web shield"
  # that re-signs HTTPS with its own root).
  #
  # The images verify certificates against the standard bundle, so a running
  # worker cannot fetch any job board and the API cannot probe a provider:
  # every outbound connection fails with CERTIFICATE_VERIFY_FAILED. This is
  # separate from the `build_ca` BuildKit secret, which covers image builds
  # only. See docs/RUNBOOK.md section 6 for how to identify the root.
  #
  # Build a MERGED bundle (the image's own store plus the intercepting root)
  # into a gitignored location - .local/ is intended for this:
  #
  #   docker run --rm --entrypoint sh job-getter/worker:dev \
  #     -c 'cat /etc/ssl/certs/ca-certificates.crt' > .local/runtime-ca-bundle.pem
  #   cat /path/to/intercepting-root.pem >> .local/runtime-ca-bundle.pem
  #
  # A merged bundle matters for the worker: SSL_CERT_FILE REPLACES the trust
  # store rather than extending it. The worker deliberately ignores every
  # other request-altering environment variable (proxies, .netrc) and honours
  # only this one; verification itself is never disabled. Node's variable is
  # additive, so the same file is harmless for the API.
  #
  # Never put the root in docker-compose.yml, in an image, or in git.
  # ---------------------------------------------------------------------------
  # worker:
  #   volumes:
  #     - ./.local/runtime-ca-bundle.pem:/etc/job-getter/ca-bundle.pem:ro
  #   environment:
  #     SSL_CERT_FILE: /etc/job-getter/ca-bundle.pem
  # api:
  #   volumes:
  #     - ./.local/runtime-ca-bundle.pem:/etc/job-getter/ca-bundle.pem:ro
  #   environment:
  #     NODE_EXTRA_CA_CERTS: /etc/job-getter/ca-bundle.pem
