# ---------------------------------------------------------------------------
# Job Getter additions
# ---------------------------------------------------------------------------

# Python / uv
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Local runner browser profile. docs/spec/07_APPLICATION_AUTOMATION.md requires
# the paired desktop runner's Chromium profile to live in a restricted local
# directory, outside the workspace export and outside git: it holds live
# job-site sessions.
services/worker/.browser-profile/
.browser-profile/
browser-profile/

# Private file storage for local installations (uploaded CVs, generated
# documents, exports). Never commit a real CV.
#
# Anchored to the repository root on purpose. An unanchored `files/` matches
# ANY directory of that name, and it silently excluded apps/api/src/files/ --
# the API's entire storage layer -- from the first eight commits. Everything
# passed locally because the files existed on disk; CI on a fresh clone could
# not compile. Keep these patterns anchored.
/files/
/data/
/storage/
*.local.sqlite

# Personal data. docs/spec/11_TESTING_ACCEPTANCE.md forbids personal data in CI
# fixtures; only the synthetic corpus under fixtures/ belongs in git.
fixtures/personal/
fixtures/private/
**/personal-cv.*
**/my-cv.*

# Local-only working files: the exported TLS-interception root used as the
# build_ca secret, captured setup output (which contains the SETUP_TOKEN),
# captured container logs, and throwaway helper scripts. Never committed.
.local/

# The dev loop's file storage (uploaded CVs and generated documents, so personal
# data) and its temporary Compose override (scripts/dev.sh, scripts/dev.ps1).
.dev-files/
.dev-compose.tmp.yml

# Secrets and generated credentials
*.pem
*.key
!infra/**/*.key.example
secrets/
.setup-token

# Backups produced by scripts/backup.*
backups/
*.dump
*.sql.gz

# Test and tooling output
test-results/
playwright-report/
.playwright/
*.tsbuildinfo

# Local Compose overrides are per-developer machine configuration. The
# committed example file documents what belongs here.
docker-compose.override.yml
