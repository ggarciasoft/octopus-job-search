# Job Getter - example environment file
# =============================================================================
# Copy this file to `.env` and then run the setup script to fill in the
# generated secrets:
#
#   cp .env.example .env
#   sh scripts/setup.sh            # POSIX shell (Linux, macOS, Git Bash)
#   pwsh -File scripts/setup.ps1   # Windows PowerShell
#
# `.env` is already excluded by `.gitignore` (see the "dotenv environment
# variable files" block in that file). NEVER commit a real `.env`, and never
# put a working secret in THIS file - `.env.example` IS committed.
#
# Every secret-valued entry below is intentionally empty. The setup script
# generates cryptographically random values for SESSION_SECRET, SETUP_TOKEN,
# ENCRYPTION_KEY and WORKER_AUTH_TOKEN. If a value is empty here and you have
# not run the setup script, the API is expected to refuse to start rather than
# fall back to a default - a default secret is not a secret.
#
# "Required (local)"  = needed for `docker compose up` / local development.
# "Required (hosted)" = needed additionally when APP_MODE=hosted.
# "Optional"          = has a working default or the feature is off.
# =============================================================================


# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------

# Deployment mode. `local` = single-owner installation bootstrapped with a
# one-time setup token over loopback. `hosted` = multi-user, adds email
# verification, password reset and invitation signup.
# Required (local + hosted). Values: local | hosted
APP_MODE=local

# Public origin the browser uses, scheme included, no trailing slash. Used for
# cookie scope, CORS/origin verification on state-changing routes and absolute
# links in email. Must match what you actually type in the address bar.
# Required (local + hosted).
APP_ORIGIN=http://localhost:3000

# TCP port the API process listens on INSIDE its container/process. Under
# Compose this is not published to the host; the web container proxies /api to
# it. Change the published web port in docker-compose.override.yml, not here.
# Required (local + hosted).
PORT=8080


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL 17 connection string used by the API and the migration runner.
# Nothing else writes to the database (invariant 1: Node owns persistence).
#
# The default below is the Compose service name `db`. For the non-Compose dev
# loop (`scripts/dev.sh`) use the host-published port instead:
#   postgresql://jobgetter:jobgetter@127.0.0.1:5432/jobgetter
# scripts/dev.sh sets that override for you.
# Required (local + hosted).
DATABASE_URL=postgresql://jobgetter:jobgetter@db:5432/jobgetter


# -----------------------------------------------------------------------------
# Secrets - generated by scripts/setup.sh, never committed
# -----------------------------------------------------------------------------

# Signing key for session cookies. 32+ random bytes, base64. Rotating it logs
# every session out. Required (local + hosted). GENERATED - leave empty here.
SESSION_SECRET=

# Single-use bootstrap token for POST /api/v1/setup. The setup script prints it
# to your terminal exactly once and writes it here; the route closes
# permanently once an owner account exists, after which this value is inert.
# Required (local). Not used when APP_MODE=hosted. GENERATED - leave empty here.
SETUP_TOKEN=

# Operator key for authenticated encryption of user-supplied provider secrets
# (AI API keys) stored in the database. MUST be exactly 32 bytes, base64
# encoded. This key lives outside the database on purpose: a database backup
# alone must not decrypt provider secrets. Losing it means stored provider
# keys cannot be decrypted and must be re-entered.
# Required (local + hosted). GENERATED - leave empty here.
ENCRYPTION_KEY=

# Shared credential the processing worker presents on /internal/v1/* routes.
# This is an operator credential, distinct from user sessions and from paired
# device tokens. A paired desktop runner NEVER receives this value.
# Required (local + hosted). GENERATED - leave empty here.
WORKER_AUTH_TOKEN=


# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------

# Where private uploads, generated documents and exports are stored.
# Required (local + hosted). Values: local | s3
STORAGE_DRIVER=local

# Directory for STORAGE_DRIVER=local. Under Compose this is the `files` named
# volume mounted at this path, so `docker compose down` preserves it.
# Required when STORAGE_DRIVER=local.
FILES_ROOT=/var/lib/job-getter/files

# S3-compatible storage. Only read when STORAGE_DRIVER=s3 (hosted default).
# Leave blank for local installations.
# Required (hosted, when STORAGE_DRIVER=s3). Optional (local).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
# Operator-side credentials. Never a user's own cloud keys. GENERATED BY YOUR
# STORAGE PROVIDER - leave empty here.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Hard cap on a single upload, in bytes. The specification caps CV uploads at
# 10 MiB (10485760). Raising this does not raise the per-purpose limits the API
# enforces; it is the outer bound.
# Optional (defaults to 10 MiB).
MAX_UPLOAD_BYTES=10485760


# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------

# Which provider adapter is selected when a workspace has not chosen one.
# `none` means no inference is attempted at all; manual profile editing, job
# import and the tracker still work (AT28). There is no silent fallback
# between providers (ADR07).
# Optional. Values: none | ollama | openai_compatible
PROVIDER_DEFAULT=none

# Operator-allowlisted base URL for a local/self-hosted model endpoint.
# Two supported shapes:
#   1. The optional Compose profile:  docker compose --profile local-ai up -d
#      then set  http://ollama:11434
#   2. An Ollama/OpenAI-compatible server you already run on your machine:
#      Linux                    -> http://172.17.0.1:11434
#      Docker Desktop (Win/mac) -> http://host.docker.internal:11434
#      Non-container dev loop   -> http://127.0.0.1:11434
# This is an OPERATOR setting. Hosted users cannot point model calls at
# arbitrary hosts, and this allowlist must not be used to widen the job-page
# fetcher's network policy.
# Optional (required when PROVIDER_DEFAULT=ollama).
LOCAL_MODEL_BASE_URL=


# -----------------------------------------------------------------------------
# Network policy for outbound fetches
# -----------------------------------------------------------------------------

# Extra hostnames the job/page fetcher may contact, comma separated, no scheme.
# Connector-declared hosts (for example boards-api.greenhouse.io) are allowed by
# their connector manifest and do not need to be listed here. Leave empty to
# allow only connector-declared hosts plus user-supplied public HTTPS URLs that
# pass the private-IP/redirect checks.
# This list never permits private, loopback, link-local or cloud-metadata
# destinations - those are blocked unconditionally.
# Optional.
ALLOWED_FETCH_HOSTS=


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Structured log verbosity. Logs are redacted: CV text, answer text, tokens and
# raw prompts are never logged at any level.
# Optional. Values: trace | debug | info | warn | error | fatal
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# SMTP - hosted authentication email only
# -----------------------------------------------------------------------------
# Used for email verification and password reset when APP_MODE=hosted. A local
# installation sends no email; leave these blank.
# Required (hosted). Unused (local).

SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS on connect (port 465); false = STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
# GENERATED BY YOUR EMAIL PROVIDER - leave empty here.
SMTP_PASSWORD=
# Envelope/from address, e.g. "Job Getter <no-reply@example.invalid>".
SMTP_FROM=


# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------

# Subscription billing is out of scope until M6 and no payment provider has
# been selected. Billing must never gate correctness of in-flight outcome
# tracking, reads, exports or manual outcome recording.
# Optional. Keep this false.
BILLING_ENABLED=false


# -----------------------------------------------------------------------------
# Worker (services/worker) - container worker and desktop runner
# -----------------------------------------------------------------------------

# Base URL the Python worker polls for /internal/v1/tasks/claim.
# Compose default is the internal API service; for the non-Compose dev loop use
# http://127.0.0.1:8080 (scripts/dev.sh sets this for you).
# Required (local + hosted).
WORKER_API_BASE_URL=http://api:8080

# Stable identifier for this worker process. Appears in task lease records and
# in the noop_echo probe result, so a smoke test can tell you which worker
# answered. Give each replica a distinct value.
# Required (local + hosted).
WORKER_ID=container-worker-1

# Task capabilities this worker will claim, comma separated.
#
# The containerised worker MUST NOT include `fill_local`. A headless container
# cannot drive the user's desktop browser and must not pretend to
# (02_ARCHITECTURE.md, ADR05). Local browser filling is the job of the paired
# desktop runner (`job-getter-runner`) or, after M5, the browser extension.
#
# Only capabilities the worker actually implements should be listed. As of M0
# the implemented task types are noop_echo and parse_profile; listing a task
# type the worker cannot perform makes the API lease it work it will fail.
# Required (local + hosted).
WORKER_CAPABILITIES=noop_echo,parse_profile,fetch_board,fetch_job,match_job,render_cv


# -----------------------------------------------------------------------------
# Compose infrastructure settings
# -----------------------------------------------------------------------------
# These are NOT part of the application environment contract in
# docs/spec/10_DEPLOYMENT.md. They configure the containers around it.

# Credentials the `db` service initialises itself with. They must agree with
# DATABASE_URL above. The database port is deliberately NOT published to the
# host by default, so this password is only reachable from the Compose network.
POSTGRES_USER=jobgetter
POSTGRES_PASSWORD=jobgetter
POSTGRES_DB=jobgetter

# Loopback address and port the web UI is published on. The specification
# requires 127.0.0.1 only - do not change this to 0.0.0.0 to "share" the app;
# there is no TLS and no hosted authentication in local mode.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Base registry for the pinned library images (postgres, node, nginx, python).
# Default is Docker Hub. If you hit "429 Too Many Requests" from Docker Hub, or
# you are behind a TLS-intercepting proxy that blocks it, switch to the AWS ECR
# Public mirror, which serves the same content-addressed images:
#   IMAGE_REGISTRY=public.ecr.aws/docker/library
# See docs/RUNBOOK.md -> "Registry rate limits and TLS interception".
IMAGE_REGISTRY=docker.io/library

# Optional local-ai profile image. Only pulled when you run
# `docker compose --profile local-ai up -d`.
OLLAMA_IMAGE=ollama/ollama:0.34.0
